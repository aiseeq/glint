#!/bin/sh
# Installed by graft init. The hook logic lives in graft itself.
if ! command -v graft >/dev/null 2>&1; then
	echo "graft: not found in PATH, the prepare-commit-msg hook cannot run." >&2
	echo "Install it, in a checkout of github.com/aiseeq/graft: git pull && go run . install" >&2
	exit 1
fi
exec graft hook prepare-commit-msg "$@"
